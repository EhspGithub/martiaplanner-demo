{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MartiaPlanner",
  "version": "1.8.0",
  "identifier": "com.martiaplanner.student",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MartiaPlanner — سامانه مدیریت مطالعه و برنامه‌ریزی دانش‌آموزی",
        "width": 1280,
        "height": 840,
        "minWidth": 375,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:martia_planner.db"
      ]
    }
  }
}
